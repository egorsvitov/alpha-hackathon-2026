{
  "$id": "urn:retriever:SearchItem:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "derived_from": {
      "additionalProperties": true,
      "title": "Derived From",
      "type": "object"
    },
    "embedding_text": {
      "minLength": 1,
      "title": "Embedding Text",
      "type": "string"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "item_version": {
      "default": "1",
      "title": "Item Version",
      "type": "string"
    },
    "kind": {
      "default": "article",
      "enum": [
        "article",
        "event"
      ],
      "title": "Kind",
      "type": "string"
    },
    "publication_count": {
      "default": 1,
      "minimum": 1,
      "title": "Publication Count",
      "type": "integer"
    },
    "source_count": {
      "default": 0,
      "minimum": 0,
      "title": "Source Count",
      "type": "integer"
    },
    "source_revision_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Revision Ids",
      "type": "array"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "was_merged": {
      "default": false,
      "title": "Was Merged",
      "type": "boolean"
    }
  },
  "required": [
    "item_id",
    "text",
    "embedding_text",
    "source_revision_ids"
  ],
  "title": "SearchItem",
  "type": "object"
}
