{
  "$id": "urn:retriever:Interest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "applicability_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicability Basis"
    },
    "applicable_when": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicable When"
    },
    "family": {
      "default": "activity",
      "enum": [
        "activity",
        "graph",
        "other"
      ],
      "title": "Family",
      "type": "string"
    },
    "interest_id": {
      "minLength": 1,
      "title": "Interest Id",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "vector": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Vector",
      "type": "array"
    }
  },
  "required": [
    "interest_id",
    "text",
    "vector"
  ],
  "title": "Interest",
  "type": "object"
}
