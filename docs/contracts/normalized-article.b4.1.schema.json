{
  "$defs": {
    "AcceptedClaim": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "policy_rate",
            "fx_rate",
            "price_change",
            "regulation",
            "sanction_or_trade_restriction",
            "market_indicator",
            "company_results",
            "investment",
            "corporate_action",
            "operational_incident",
            "other"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/SourceClaim"
        }
      },
      "required": [
        "candidate_id",
        "event_type",
        "claim"
      ],
      "title": "AcceptedClaim",
      "type": "object"
    },
    "CheckedExcluded": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "title",
            "text"
          ],
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field",
        "start",
        "end",
        "quote",
        "reason"
      ],
      "title": "CheckedExcluded",
      "type": "object"
    },
    "ClaimTime": {
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "forecast_horizon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "occurred_at",
        "effective_at",
        "observation_period",
        "forecast_horizon"
      ],
      "title": "ClaimTime",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "issue": {
          "$ref": "#/$defs/Issue"
        }
      },
      "required": [
        "severity",
        "candidate_id",
        "issue"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "name"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "title",
            "text"
          ],
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "field",
        "start",
        "end",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "JsonValue": {},
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "minLength": 1,
          "title": "Measurement Id",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "kind": {
          "enum": [
            "level",
            "absolute_change",
            "relative_change"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "$ref": "#/$defs/ValueRange"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "qualifier": {
          "enum": [
            "exact",
            "approximate",
            "gt",
            "gte",
            "lt",
            "lte"
          ],
          "title": "Qualifier",
          "type": "string"
        },
        "comparison_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_role": {
          "enum": [
            "reported",
            "before",
            "after",
            "comparison"
          ],
          "title": "Value Role",
          "type": "string"
        }
      },
      "required": [
        "measurement_id",
        "metric",
        "kind",
        "value",
        "unit",
        "qualifier",
        "comparison_period",
        "value_role"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "name",
        "role"
      ],
      "title": "Participant",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "Period",
      "type": "object"
    },
    "RejectedClaim": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "issues"
      ],
      "title": "RejectedClaim",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "baseline",
            "alternative",
            "unspecified"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "article_id": {
          "minLength": 1,
          "title": "Article Id",
          "type": "string"
        },
        "article_version": {
          "minimum": 1,
          "title": "Article Version",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publisher"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "content_kind": {
          "enum": [
            "original",
            "source_based_paraphrase",
            "synthetic",
            "user_provided",
            "unknown"
          ],
          "title": "Content Kind",
          "type": "string"
        },
        "is_full_original_text": {
          "title": "Is Full Original Text",
          "type": "boolean"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "article_id",
        "article_version",
        "title",
        "publisher",
        "url",
        "published_at",
        "content_kind",
        "is_full_original_text",
        "is_synthetic"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "modality": {
          "enum": [
            "asserted",
            "forecast",
            "plan",
            "proposal",
            "opinion",
            "unknown"
          ],
          "title": "Modality",
          "type": "string"
        },
        "polarity": {
          "enum": [
            "affirmed",
            "negated",
            "unknown"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "announced",
                "proposed",
                "approved",
                "effective",
                "repealed",
                "observed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stage"
        },
        "attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Entity"
            },
            {
              "type": "null"
            }
          ]
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "title": "Participants",
          "type": "array"
        },
        "action": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "object": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object"
        },
        "geographies": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Geographies",
          "type": "array",
          "uniqueItems": true
        },
        "time": {
          "$ref": "#/$defs/ClaimTime"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "field_evidence": {
          "minProperties": 1,
          "patternProperties": {
            "^/": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "title": "Field Evidence",
          "type": "object"
        },
        "scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scenario"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "claim_id",
        "text",
        "modality",
        "polarity",
        "stage",
        "attribution",
        "participants",
        "action",
        "object",
        "geographies",
        "time",
        "measurements",
        "evidence_ids",
        "field_evidence",
        "scenario"
      ],
      "title": "SourceClaim",
      "type": "object"
    },
    "Transformation": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "input_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "output_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "metadata_refs": {
          "items": {
            "type": "string"
          },
          "title": "Metadata Refs",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "path",
        "rule",
        "input_value",
        "output_value",
        "evidence_ids",
        "metadata_refs"
      ],
      "title": "Transformation",
      "type": "object"
    },
    "ValueRange": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Min",
          "type": "string"
        },
        "max": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Max",
          "type": "string"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "ValueRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "b4.1",
      "default": "b4.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "input_artifact_id": {
      "minLength": 1,
      "title": "Input Artifact Id",
      "type": "string"
    },
    "article_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Article Sha256",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "verification_status": {
      "const": "structure_quotes_and_rules_checked",
      "default": "structure_quotes_and_rules_checked",
      "title": "Verification Status",
      "type": "string"
    },
    "semantic_support": {
      "const": "not_assessed",
      "default": "not_assessed",
      "title": "Semantic Support",
      "type": "string"
    },
    "candidate_count": {
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "accepted": {
      "items": {
        "$ref": "#/$defs/AcceptedClaim"
      },
      "title": "Accepted",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "rejected": {
      "items": {
        "$ref": "#/$defs/RejectedClaim"
      },
      "title": "Rejected",
      "type": "array"
    },
    "excluded": {
      "items": {
        "$ref": "#/$defs/CheckedExcluded"
      },
      "title": "Excluded",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "transformations": {
      "items": {
        "$ref": "#/$defs/Transformation"
      },
      "title": "Transformations",
      "type": "array"
    },
    "quality": {
      "enum": [
        "complete",
        "partial",
        "insufficient"
      ],
      "title": "Quality",
      "type": "string"
    }
  },
  "required": [
    "source",
    "input_artifact_id",
    "article_sha256",
    "configuration_sha256",
    "candidate_count",
    "accepted",
    "evidence",
    "rejected",
    "excluded",
    "diagnostics",
    "limitations",
    "transformations",
    "quality"
  ],
  "title": "NormalizedArticleResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
