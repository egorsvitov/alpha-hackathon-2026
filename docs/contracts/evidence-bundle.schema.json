{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/evidence-bundle.schema.json",
  "title": "EvidenceBundle v0.1 — retrieval candidates, never an asserted bank position",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "event_id", "event_version", "company_id", "profile_version", "as_of", "corpus_version", "query_plan", "hits", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["ok", "partial", "no_bank_evidence", "unavailable"]},
    "event_id": {"type": "string", "minLength": 1}, "event_version": {"type": "integer", "minimum": 1},
    "company_id": {"type": "string", "minLength": 1}, "profile_version": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "corpus_version": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "query_plan": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/attempt"}},
    "hits": {"type": "array", "items": {"$ref": "#/$defs/hit"}},
    "limitations": {"$ref": "#/$defs/strings"}, "diagnostics": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"properties": {"corpus_version": {"type": "null"}, "hits": {"maxItems": 0}}}, "else": {"properties": {"corpus_version": {"$ref": "#/$defs/hash"}}}},
    {"if": {"properties": {"status": {"enum": ["no_bank_evidence", "unavailable"]}}}, "then": {"properties": {"hits": {"maxItems": 0}}}, "else": {"properties": {"hits": {"minItems": 1}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "queries", "topic_filters", "temporal_mode", "retry_reason", "config_version", "corpus_version"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 0, "maximum": 2},
        "queries": {"$ref": "#/$defs/strings", "minItems": 1}, "topic_filters": {"$ref": "#/$defs/strings"},
        "temporal_mode": {"enum": ["strict_replay", "daily", "research_current"]},
        "retry_reason": {"type": ["string", "null"]}, "config_version": {"$ref": "#/$defs/hash"},
        "corpus_version": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "reasons": {"$ref": "#/$defs/strings"}
      },
      "if": {"properties": {"attempt": {"minimum": 1}}},
      "then": {"properties": {"retry_reason": {"type": "string", "minLength": 1}}}
    },
    "hit": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "document_id", "document_sha256", "chunk_id", "page", "char_start", "char_end", "quote", "text_sha256", "source_path", "title", "published_at", "date_status", "verification_status", "retrieval_score", "matched_queries", "limitations", "is_synthetic"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^bank:[0-9a-f]{64}$"},
        "document_id": {"type": "string", "minLength": 1}, "document_sha256": {"$ref": "#/$defs/hash"},
        "chunk_id": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1},
        "char_start": {"type": "integer", "minimum": 0}, "char_end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}, "text_sha256": {"$ref": "#/$defs/hash"},
        "source_path": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "published_at": {"oneOf": [{"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}]},
        "date_status": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["pending_review", "visually_checked_excerpt", "synthetic"]},
        "retrieval_score": {"type": "number", "exclusiveMinimum": 0},
        "matched_queries": {"$ref": "#/$defs/strings", "minItems": 1}, "limitations": {"$ref": "#/$defs/strings"},
        "is_synthetic": {"type": "boolean"}, "provenance_status": {"type": "object"}
      },
      "if": {"properties": {"is_synthetic": {"const": true}}},
      "then": {"properties": {"verification_status": {"const": "synthetic"}}}
    }
  }
}
