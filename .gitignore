# Runtime and secrets
__pycache__/
*.pyc
.env
.venv/
.venv_news/
.venv_events/
.venv_telegram/
.cache/

# Supplied materials remain local; publication terms pending.
/data/companies/
/data/analytics/
/data/task/
/data/context/
/data/raw_news/
*.pdf

# Full-text derivatives and generated images remain local.
/data/processed/ocr/
/data/processed/previews/
/data/processed/extracted/
/data/processed/rag_chunks.jsonl
/data/processed/events/

# News pipeline derived data (full text, cache) remain local.
/data/processed/news/
/data/processed/news_cache/
/data/processed/events_state/
/data/processed/events_catalog.json

# News pipeline secrets (LLM key), separate from backend .env.
news/.env
llm/events/.env

# News pipeline confidential source data (must NOT be committed):
# Alpha-Bank analytics PDFs, company/payment/individual CSV datasets.
news/drive-download-*/
news/*.csv
news/*.pdf
news/.DS_Store

# macOS metadata everywhere.
.DS_Store

# SQLite и логи (не в git)
*.db
*.sqlite
*.sqlite3
alfa_hack.db
*.log

# Telegram account sessions (including sidecars) must never enter Git.
*.session
*.session-journal
*.session-wal
*.session-shm

# Internal reports removed from public history.
/reports/

/data/processed/event_pipeline/

# Download archives, local runtime locks, and source-bearing GPU artifacts.
/tmp_file/
*.egg-info/
