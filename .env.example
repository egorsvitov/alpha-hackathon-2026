# Настройки запуска через Docker Compose. Скопируйте в .env:  cp .env.example .env
# .env не попадает в git. Секреты (ключи LLM) храните только там.

# Порты на вашем компьютере
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Откуда фронт берёт данные:
#   mock — всё считается в браузере, backend не нужен (по умолчанию, пока backend отдаёт заглушки)
#   http — фронт ходит в backend через /api/ (когда ответы backend приведены к docs/frontend-api-contract.md)
APP_API_MODE=mock
# Адрес API для режима http. Оставьте пустым: запросы пойдут на тот же адрес, что и сайт.
APP_API_URL=

# backend (см. backend/app/core/config.py)
MOCK_MODE=true

# Ключ LLM: когда появится агент, положите сюда, например
# LLM_API_KEY=

# Настройки LLM Business Analyst (см. backend/app/analyst/settings.py):
#   template — шаблонный режим без LLM (по умолчанию)
#   cached   — предрасчитанный кэш из репозитория без сетевых вызовов
#   llm      — живой вызов LLM через шлюз с кэшем и офлайн-откатом
# ANALYST_MODE=cached
# ANALYST_MODEL=z-ai/glm-5.3-flash
# ANALYST_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# ANALYST_PREFER_CACHE=true
# ANALYST_DAILY_BUDGET_RUB=400
# ANALYST_PROMPT_VERSION=analyst-v1.0
# ANALYST_MEMORY=false
# ANALYST_FEWSHOT=false
