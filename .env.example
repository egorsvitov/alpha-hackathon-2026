# Настройки запуска через Docker Compose. Скопируйте в .env:  cp .env.example .env
# .env не попадает в git. Секреты (ключи LLM) храните только там.

# Порты на вашем компьютере
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Откуда фронт берёт данные:
#   mock — явный старый демонстрационный режим в браузере
#   http — фронт читает сохранённые результаты backend через /api/ (по умолчанию)
APP_API_MODE=http
# Адрес API для режима http. Оставьте пустым: запросы пойдут на тот же адрес, что и сайт.
APP_API_URL=

# backend (см. backend/app/core/config.py)
MOCK_MODE=false

# Ключ LLM: когда появится агент, положите сюда, например
# LLM_API_KEY=

# Persisted full-cycle API; demo is available only with FULL_CYCLE_MODE=demo + APP_API_MODE=mock.
FULL_CYCLE_MODE=persisted
# FULL_CYCLE_COMPANY=...
# FULL_CYCLE_AS_OF=2026-10-24T00:00:00+03:00
# FULL_CYCLE_FINGERPRINT=...
# BGE_MODEL_PATH=/absolute/local/model
# BGE_REFERENCE_PATH=/absolute/local/reference
# NEWS_EVERY=3600
