# Настройки запуска через Docker Compose. Скопируйте в .env:  cp .env.example .env
# .env не попадает в git. Секреты (ключи LLM) храните только там.

# Порты на вашем компьютере
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Откуда фронт берёт данные:
#   mock — всё считается в браузере, backend не нужен (по умолчанию, пока backend отдаёт заглушки)
#   http — фронт ходит в backend через /api/ (когда ответы backend приведены к docs/frontend-api-contract.md)
APP_API_MODE=mock
# Адрес API для режима http. Оставьте пустым: запросы пойдут на тот же адрес, что и сайт.
APP_API_URL=

# backend (см. backend/app/core/config.py)
MOCK_MODE=true

# Ключ LLM: когда появится агент, положите сюда, например
# LLM_API_KEY=
