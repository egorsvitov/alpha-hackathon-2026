          "type": "string"
        },
        "fragment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fragment Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "fragment_ids"
      ],
      "title": "Paragraph",
      "type": "object"
    }
