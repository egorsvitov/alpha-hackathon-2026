{
  "$defs": {
    "Disposition": {
      "additionalProperties": false,
      "properties": {
        "fragment_id": {
          "title": "Fragment Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "used",
            "duplicate",
            "service",
            "unresolved"
          ],
          "title": "Kind",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "kind"
      ],
      "title": "Disposition",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "embedding_text": {
          "title": "Embedding Text",
          "type": "string"
        },
        "article_ids": {
          "items": {
            "type": "string"
          },
          "title": "Article Ids",
          "type": "array"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/Fragment"
          },
          "title": "Fragments",
          "type": "array"
        },
        "disagreements": {
          "items": {
            "$ref": "#/$defs/Paragraph"
          },
          "title": "Disagreements",
          "type": "array"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/Paragraph"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "was_merged": {
          "title": "Was Merged",
          "type": "boolean"
        },
        "publication_count": {
          "title": "Publication Count",
          "type": "integer"
        },
        "source_count": {
          "title": "Source Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "embedding_text",
        "article_ids",
        "fragments",
        "disagreements",
        "paragraphs",
        "was_merged",
        "publication_count",
        "source_count"
      ],
      "title": "Event",
      "type": "object"
    },
    "Fragment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "article_id": {
          "title": "Article Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "title",
            "text"
          ],
          "title": "Field",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "article_id",
        "field",
        "start",
        "end",
        "text"
      ],
      "title": "Fragment",
      "type": "object"
    },
    "Paragraph": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "fragment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fragment Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "fragment_ids"
      ],
      "title": "Paragraph",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": "cluster-merge.v1",
