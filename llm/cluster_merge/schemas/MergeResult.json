      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "deferred",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "merged",
            "split",
            "unchanged"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mode"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Disposition"
      },
      "title": "Coverage",
      "type": "array"
    },
    "unresolved": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved",
      "type": "array"
    },
    "calls": {
      "title": "Calls",
      "type": "integer"
    },
    "usage": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Usage",
      "type": "array"
    },
    "cache_hit": {
      "default": false,
      "title": "Cache Hit",
      "type": "boolean"
    },
    "expected_cluster_id": {
      "title": "Expected Cluster Id",
      "type": "string"
    },
    "expected_revision": {
      "title": "Expected Revision",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "id",
    "operation_id",
    "input_hash",
    "configuration",
    "status",
    "events",
    "coverage",
    "unresolved",
    "calls",
    "usage",
    "expected_cluster_id",
    "expected_revision"
  ],
  "title": "MergeResult",
  "type": "object"
}
