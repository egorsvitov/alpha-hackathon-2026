{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft personalized insight contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "company_id", "user_role", "as_of", "status", "event_id", "significance", "changes_since_previous", "claims", "sources", "features_used", "limitations", "trace", "usage"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string"},
    "company_id": {"type": "string"},
    "user_role": {"type": "string"},
    "as_of": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "limited", "needs_clarification", "insufficient_evidence", "budget_exhausted", "failed"]},
    "event_id": {"type": "string"},
    "changes_since_previous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "previous_insight_id", "summary", "claim_ids"],
      "properties": {
        "status": {"enum": ["new", "continuation", "escalation", "deescalation", "unknown"]},
        "previous_insight_id": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "significance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "method", "reasons"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "level": {"enum": ["low", "medium", "high", "unknown"]},
        "method": {"type": "string"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "features_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "path", "value", "origin", "quality"],
        "properties": {
          "feature_id": {"type": "string"},
          "path": {"type": "string"},
          "value": {},
          "origin": {"type": "object"},
          "quality": {"enum": ["observed", "derived", "synthetic", "unknown", "conflicting"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "trace": {
      "type": "object",
      "required": ["artifact_ids", "qa_status", "retry_count"],
      "properties": {
        "artifact_ids": {"type": "array", "items": {"type": "string"}},
        "qa_status": {"enum": ["passed", "limited", "failed", "not_run"]},
        "retry_count": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cost_rub", "pricing_status"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_rub": {"type": ["number", "null"], "minimum": 0},
        "pricing_status": {"enum": ["actual", "estimated", "unknown", "no_llm_calls"]}
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "section", "kind", "text", "source_ids", "feature_ids", "assumptions", "support_status"],
      "properties": {
        "claim_id": {"type": "string"},
        "section": {"enum": ["what_happened", "why_important", "risk", "opportunity", "next_step", "bank_view"]},
        "kind": {"enum": ["source_fact", "bank_view", "ai_inference"]},
        "text": {"type": "string"},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "feature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "support_status": {"enum": ["supported", "conditional", "pending_review"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "ai_inference"}}}, "then": {"properties": {"feature_ids": {"minItems": 1}}}},
        {"if": {"properties": {"section": {"const": "bank_view"}}}, "then": {"properties": {"kind": {"const": "bank_view"}}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "type", "locator", "published_at", "quote", "verification_status"],
      "properties": {
        "source_id": {"type": "string"},
        "type": {"enum": ["news", "bank_analytics", "synthetic_news"]},
        "locator": {"type": "string"},
        "published_at": {"type": ["string", "null"]},
        "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "chunk_id": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "quote": {"type": "string"},
        "verification_status": {"enum": ["visually_checked_excerpt", "pending_review", "synthetic"]}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "bank_analytics"}}}, "then": {"required": ["document_sha256", "chunk_id", "page"]}}
      ]
    }
  }
}
