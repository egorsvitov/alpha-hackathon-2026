    {
      "rule_id": "policy_rate_loan_v1",
      "event_match": {
        "event_types": [
          "policy_rate"
        ],
        "claim_any_of": [
          {
            "path": "/object",
            "aliases": [
              "policy_rate",
              "ключевая ставка"
            ]
          },
          {
            "path": "/measurements/*/metric",
            "aliases": [
              "policy_rate"
            ]
          }
        ]
      },
      "company_match": {
        "path": "/products/loan",
        "op": "equals",
        "value": true
      },
      "geography_policy": "ru_or_unknown",
      "awards": [
        {
          "group": "product",
          "points": 28,
          "mechanism": "financing_conditions"
        },
        {
          "group": "macro",
          "points": 4,
          "mechanism": "monetary_context"
        }
      ]
    },
